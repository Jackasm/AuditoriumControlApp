<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Видеопроцессор -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Видеопроцессор"
            android:textSize="20sp"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <Spinner
                android:id="@+id/spinner_video_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:prompt="@string/video_input" />

            <Spinner
                android:id="@+id/spinner_video_output"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:prompt="@string/video_output" />
        </LinearLayout>

        <!-- Звуковой процессор -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Звуковой процессор"
            android:textSize="20sp"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="8dp" />

        <include
            android:id="@+id/sound_control_device_1"
            layout="@layout/sound_control_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />

        <include
            android:id="@+id/sound_control_device_2"
            layout="@layout/sound_control_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />

        <include
            android:id="@+id/sound_control_device_3"
            layout="@layout/sound_control_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />

        <include
            android:id="@+id/sound_control_device_4"
            layout="@layout/sound_control_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />

        <include
            android:id="@+id/sound_control_device_5"
            layout="@layout/sound_control_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp" />

        <!-- Управление камерами -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Управление камерами"
            android:textSize="20sp"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="8dp" />

        <RadioGroup
            android:id="@+id/radio_group_cameras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <RadioButton
                android:id="@+id/radio_camera_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Камера 1" />

            <RadioButton
                android:id="@+id/radio_camera_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Камера 2" />
        </RadioGroup>

        <!-- Кнопки управления камерой -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/button_camera_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вверх"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_camera_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Влево"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/button_camera_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Вниз"
                    android:padding="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/button_camera_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вправо"
                android:padding="8dp" />

            <!-- Приближение/удаление -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <Button
                    android:id="@+id/button_camera_zoom_in"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Приблизить" />

                <Button
                    android:id="@+id/button_camera_zoom_out"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Отдалить" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>