<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Видеопроцессор -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Видеопроцессор"
                android:textSize="20sp"
                android:layout_gravity="center_horizontal"
                android:paddingBottom="8dp" />

            <!-- Спиннер для видеовыхода "Панель" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Панель:"
                    android:paddingEnd="8dp" />

                <Spinner
                    android:id="@+id/spinner_video_output_panel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:prompt="@string/video_input"
                    android:entries="@array/video_inputs" />
            </LinearLayout>

            <!-- Спиннер для видеовыхода "ВКамера" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Камера:"
                    android:paddingEnd="8dp" />

                <Spinner
                    android:id="@+id/spinner_video_output_camera"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:prompt="@string/video_input"
                    android:entries="@array/video_inputs" />
            </LinearLayout>
        </LinearLayout>

        <!-- Звуковой процессор -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Звуковой процессор"
            android:textSize="20sp"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="8dp" />

        <SeekBar
            android:id="@+id/seekBar_volume_device_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:paddingBottom="8dp" />

        <SeekBar
            android:id="@+id/seekBar_volume_device_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:paddingBottom="8dp" />

        <SeekBar
            android:id="@+id/seekBar_volume_device_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:paddingBottom="8dp" />

        <SeekBar
            android:id="@+id/seekBar_volume_device_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:paddingBottom="8dp" />

        <SeekBar
            android:id="@+id/seekBar_volume_device_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:paddingBottom="16dp" />

        <!-- Камеры -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Камера 1"
            android:textSize="16sp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/camera_1_pan_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Поворот: -"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/camera_1_tilt_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Наклон: -"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Камера 2"
            android:textSize="16sp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/camera_2_pan_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Поворот: -"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/camera_2_tilt_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Наклон: -"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>