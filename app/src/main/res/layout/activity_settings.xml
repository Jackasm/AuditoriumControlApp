<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textSize="32sp"
            android:textColor="#0000FF"
            android:fontFamily="@font/bohema_pink"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="16dp" />

        <!-- Настройки для Аудитории 1 -->
        <include layout="@layout/auditorium_settings_item"
            android:id="@+id/auditorium_1_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp" />

        <!-- Настройки для Аудитории 2 -->
        <include layout="@layout/auditorium_settings_item"
            android:id="@+id/auditorium_2_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp" />

        <!-- Настройки для Аудитории 3 -->
        <include layout="@layout/auditorium_settings_item"
            android:id="@+id/auditorium_3_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp" />

        <!-- Настройки для Аудитории 4 -->
        <include layout="@layout/auditorium_settings_item"
            android:id="@+id/auditorium_4_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp" />

        <!-- Кнопка сохранения (заменена на TextView) -->
        <TextView
            android:id="@+id/button_save_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сохранить"
            android:textSize="20sp"
            android:textColor="#0000FF"
            android:fontFamily="@font/bohema_pink"
            android:layout_gravity="center_horizontal"
            android:paddingTop="16dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</ScrollView>